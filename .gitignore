# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
# /build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# python envs and scan-tracking intermediates
/backend/venv
/backend/vidtrack/work
/backend/vidtrack/assets
/backend/vidtrack/*.log

# Scan-compositor footage. The solved tracks and meshes are committed, but the
# source videos are tens of MB each; regenerate them with
#   backend/vidtrack/pipeline.py --name <take> --only export
/public/mv/**/*.mp4
/backend/vidtrack/__pycache__

# SAM 2 weights for the roto stage (fetched by roto_server.py / pipeline.py)
/backend/vidtrack/checkpoints

# Compositor work in progress: project saves (written by the dev server) and
# roto sessions (clicks and paint, backend/vidtrack/roto_server.py). Media a
# project uses is linked, never copied into the repo.
/compositor-projects
/backend/vidtrack/roto/

# Quad Trees presets (written by the dev server from the Quad Trees tool)
/quadtree-presets
